{
  // The web build of Courier Dash, served as static files from a Cloudflare Worker.
  // There is no Worker code: the game asks no server but its own for anything.
  //
  // Build first, then deploy:
  //   flutter build web --release --no-web-resources-cdn
  //   npx wrangler deploy
  "name": "jump-runner-web",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./build/web" },
  // No public address since 2026-10-26: imagine.wjd.io went back to imagine-feed (the
  // image generator) through the home tunnel. Pick a new hostname, and put an Access app
  // in front of it first, before adding a route here. workers.dev stays off.
  "workers_dev": false,
  "observability": { "enabled": true }
}
